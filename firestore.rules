rules_version = '2';

// Deny everything.
//
// This is not a placeholder -- it is the design. The browser never talks to
// Firestore directly; every read and write goes through the Cloud Run API,
// which uses the Admin SDK and therefore bypasses these rules.
//
// Keeping the rules closed means there is exactly ONE place where
// authorisation happens (the API), instead of two implementations that can
// drift apart. If a future feature ever needs direct client access, it gets
// explicit rules here -- never a blanket allow.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
