# Local development. On Cloud Run these are set as service env vars, and the
# two secrets belong in Secret Manager, not here.

# Bucket holding the originals. Must NOT be public.
STORAGE_BUCKET=steinabi-originals

# Signs session tokens. Generate: openssl rand -base64 48
SESSION_SECRET=

# Salts the code and IP hashes. Changing it invalidates every stored hash.
HASH_SALT=

# Comma separated. The deployed site, plus localhost for development.
ALLOWED_ORIGINS=https://stein-abi.pages.dev,http://localhost:4200

# Optional, defaults shown.
SESSION_TTL_HOURS=12
LOGIN_ATTEMPTS_PER_HOUR=10
UPLOADS_PER_HOUR=40
UPLOAD_BYTES_PER_HOUR=5368709120
FIRESTORE_DATABASE=(default)
