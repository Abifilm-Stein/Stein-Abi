# Security headers, served by Cloudflare for every response.
# Angular copies everything in public/ to the output root, so this file ends
# up next to index.html where Cloudflare picks it up.
#
# Ticks off the "Security-Header setzen" item in the README checklist.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # CSP notes -- read before tightening:
  #   script-src 'unsafe-inline' is required by the inline window.__STEINABI__
  #     config block in index.html. Removing that block (e.g. by serving the
  #     config from an endpoint) is what would let you drop it.
  #   style-src 'unsafe-inline' is required by Angular, which injects
  #     component styles as <style> elements at runtime.
  #   blob: in img-src/media-src is required by the upload previews, which use
  #     URL.createObjectURL. Without it every thumbnail breaks.
  #   connect-src must be extended with the upload endpoint and API base URL
  #     once a backend is configured, otherwise uploads are blocked:
  #     connect-src 'self' https://<project-ref>.supabase.co;
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

# Hashed bundles are immutable -- cache them hard.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# The shell must never be cached, or a deploy does not reach existing visitors.
/index.html
  Cache-Control: no-cache
