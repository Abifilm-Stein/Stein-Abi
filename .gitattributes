# Normalise line endings in the repository to LF so Windows and macOS
# checkouts do not produce diffs that consist only of line-end changes.
* text=auto eol=lf

# Binary files: never touch.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.mp4 binary
*.mov binary

# Keep generated lockfile diffs out of review noise.
package-lock.json -diff linguist-generated
