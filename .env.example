# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# NOTE: Only the two values injected into index.html reach the browser, and
# both are public by design. Everything marked SERVER-ONLY must stay in the
# hosting provider's secret store and never be referenced from src/.

# --- Browser (public) ------------------------------------------------------

# tus 1.0.0 creation endpoint for resumable uploads.
# Supabase: https://<project-ref>.supabase.co/storage/v1/upload/resumable
STEINABI_UPLOAD_ENDPOINT=

# Base URL of the submissions API (edge functions or your own service).
STEINABI_API_BASE_URL=

# --- Server only -----------------------------------------------------------

# Supabase project, EU region (Frankfurt) -- required, see the migration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket holding the originals. Must NOT be public.
SUPABASE_STORAGE_BUCKET=abifilm-originals

# SERVER-ONLY. Salt for hashing access codes and truncated IP hashes.
ACCESS_CODE_SALT=

# Rate limiting per IP and hour.
RATE_LIMIT_FILES_PER_HOUR=40
RATE_LIMIT_BYTES_PER_HOUR=5368709120
